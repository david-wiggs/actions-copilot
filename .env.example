# Environment Variables for Actions Copilot

# Local LLM Configuration (Ollama)
# Start Ollama and pull a model first:
#   ollama pull mistral:7b
# Then run: ollama serve
LLM_API_URL=http://localhost:11434/v1/chat/completions
LLM_API_KEY=ollama
LLM_MODEL=mistral:7b

# --- Remote API alternatives (comment out local config above if using these) ---
# OpenAI:
#   LLM_API_URL=https://api.openai.com/v1/chat/completions
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4
# LM Studio (also OpenAI-compatible):
#   LLM_API_URL=http://localhost:1234/v1/chat/completions
#   LLM_API_KEY=lm-studio
#   LLM_MODEL=<model-name-from-lm-studio>
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.2

# GitHub App Configuration
APP_ID=your_github_app_id_here
PRIVATE_KEY_PATH=./private-key.pem
WEBHOOK_SECRET=your_webhook_secret_here

# Protection Rules Configuration
PROTECTED_ENVIRONMENTS=production,staging
BLOCK_ON_MALICIOUS=true
ALLOWED_ACTIONS=actions/checkout,actions/setup-node,actions/upload-artifact
BLOCKED_KEYWORDS=rm -rf,curl,wget,download,exec,eval

# Dependency Analysis Configuration
DEPENDENCY_ANALYSIS_ENABLED=true
DEPENDENCY_RESOLVE_TRANSITIVE=true
DEPENDENCY_REQUIRE_SHA_PIN=false
DEPENDENCY_APPROVED_ORGS=
DEPENDENCY_BLOCKED_ACTIONS=
DEPENDENCY_BLOCK_ON_VIOLATION=false
DEPENDENCY_MIN_SEVERITY=high

# Application Configuration
PORT=3000
NODE_ENV=production
