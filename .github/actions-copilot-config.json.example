{
  "llm": {
    "apiUrl": "http://localhost:11434/v1/chat/completions",
    "model": "mistral:7b",
    "maxTokens": 1000,
    "temperature": 0.2
  },
  "protectionRules": {
    "enabledEnvironments": ["production", "staging"],
    "blockOnMaliciousDetection": true,
    "allowedActions": [
      "actions/checkout",
      "actions/setup-node",
      "actions/upload-artifact",
      "actions/download-artifact"
    ],
    "blockedKeywords": [
      "rm -rf",
      "curl",
      "wget",
      "download",
      "exec",
      "eval",
      "sudo"
    ]
  },
  "dependencyAnalysis": {
    "enabled": true,
    "resolveTransitive": true,
    "requireShaPin": true,
    "approvedOrganizations": ["actions", "github"],
    "blockedActions": [],
    "blockOnPolicyViolation": true,
    "minimumViolationSeverity": "high"
  }
}
